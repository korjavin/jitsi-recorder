# Copy to .env (or set in the Portainer stack). Placeholders only.

# Required. HMAC secret shared with the orchestrator; empty refuses to start.
RECORDER_SECRET=change-me
# Allowlist: only meeting URLs under this base are recorded.
JITSI_BASE_URL=https://meet.example.com
# HTTP port inside the container.
PORT=8080
# Name the bot joins the call with.
BOT_DISPLAY_NAME=NoteTaker
# Fail as not_admitted if not in the call within this many seconds.
JOIN_TIMEOUT_S=600
# Hard cap on one recording, seconds.
MAX_DURATION_S=14400
# Stop this many seconds after the bot is alone in the room.
EMPTY_GRACE_S=60
# debug | info | error
LOG_LEVEL=info
# DATA_DIR (default /data/jitsi) is fixed in docker-compose.yml.

# Compose only, not read by the service:
# shared recordings volume, created once with `docker volume create recordings`
RECORDINGS_VOLUME=recordings
# external Docker network shared with the orchestrator
TRAEFIK_NETWORK_NAME=traefik
